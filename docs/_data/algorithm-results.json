  "captions": {
    "alg-01-spacing-waterfill": {
      "caption": "按湿度加权后，最湿的 A–B 间隙拿到 134 mm，最干的 C–D 只留 90 mm（等距时都是 110 mm），总跨度不变（480 mm）——同一根杆，湿衣服多拿风道。"
    },
    "alg-02-spacing-feasibility": {
      "caption": "目标跨度低于最小可行跨度（4 件 30 mm 厚 → 210 mm）时程序不硬压安全间隙、会自动放宽并告警；超过 L_max=1100 mm 则截断；1.2 m 杆在 30 mm 间隙下最多挂 17 件 35 mm 厚的衣物。"
    },
    "alg-03-reorder-steps": {
      "caption": "4 件按湿度重排：上界 N−1 = 3 次 move-to-end，本例只需 2 次（A、C 依次移到最远端），预计 25.2 s。"
    },
    "alg-04-reorder-cost": {
      "caption": "换序耗时随件数近似线性增长，最坏情况 4 件就要 36.5 s、6 件 93.1 s，远超 30 s 预算；只调间距只要 12.3 s —— 这就是 P0 不做换序的量化理由。"
    },
    "alg-05-control-step": {
      "caption": "纯 P 在 1° 坡度下留下 -1.1 mm 稳态误差，PID 降到 0.16 mm；PID 超调 0.51 mm、稳定 6.4 s；坡度 3° 时 P 的偏差扩大到 -3.4 mm，已吃掉 ±5 mm 预算的 68%。"
    },
    "alg-06-control-montecarlo": {
      "caption": "200 次蒙特卡洛（噪声、延迟、坡度、初始误差一起抖）后，PID 的超调 p95 0.68 mm、稳态误差 p95 0.33 mm、稳定时间 p95 7.3 s，全部落在 ±5 mm / 8 s 以内。"
    },
    "alg-07-vision-error": {
      "caption": "相机侧装（偏航 0°）时 1.2 m 处沿杆随机误差只有 0.67 mm；但偏航 10° 后总预算 5.30 mm 超标，靠 5 帧平均降到 3.26 mm，系统误差（标定 1.5 mm + 安装 2.0 mm）才是精度预算的大头。"
    }
  }
}