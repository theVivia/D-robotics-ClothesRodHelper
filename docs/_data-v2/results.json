  "captions": {
    "v2-01-length-plan": {
      "caption": "外端锚点 0/D 固定（D=460 mm）：等距时端部内端各 60 mm、内部 3 段各 100 mm，链长 460 完全贴合；加权只用 12 cm 平均预算重分配内部段，收衣＝内部回 100 mm，端部回到 60。"
    },
    "v2-02-chain-order": {
      "caption": "每个调节器有 L/R 两个锥面收口夹头：锁一端就能单向伸缩、只推动相邻衣架；锚定左锚点逐段调，峰值轴向力 14 N / 电流 0.49 A，已定位段 0 滑移；不锁端整链推则 14 N / 2.44 A，且要重新标定全部衣架。"
    },
    "v2-03-timing": {
      "caption": "日常（12 cm→收衣）5 段都动、行程 120 mm：4 mm/s 校核 37.0 s（超 30 s）、7 mm/s 提速 24.1 s（达标）；安装标定（一次性）21 s。"
    },
    "v2-04-control": {
      "caption": "长度闭环 100→160 mm：T8/8 @4 mm/s（校核） 上升 12.0 s、稳态误差 +0.02 mm、超调 0.02 mm；0.2 mm 反向间隙在负载侧只剩 ±72 µm；2 s 卡死时 295 ms 判出堵转。"
    },
    "v2-05-error-budget": {
      "caption": "净风道误差 RSS 0.53 mm（最坏叠加 0.87 mm），20000 次蒙特卡洛里 100.0% 落在 ±2 mm 内；最大项是衣架/端面定位公差 0.5 mm（占方差 90%），丝杆和编码器都不是瓶颈。"
    },
    "v2-06-vision-id": {
      "caption": "真实 ArUco 检测器在 6–10 px 才掉识别率，1.5 m、30 mm 标记有 18 px，余量 2 倍以上；限制项是遮挡——3 帧去抖后 5 个 ID 全认全 100.0%、p95 0.30 s，认不出时用长度反馈 + 固定顺序降级。"
    }
  }
